<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.scenory.controller.WelcomeController"
            styleClass="welcome-screen">

    <!-- ============ SIDEBAR (YT Music-style: compact, flat, quiet) ============ -->
    <left>
        <VBox styleClass="sidebar" spacing="0">

            <!-- Logo -->
            <HBox styleClass="sidebar-header" spacing="8" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>
                <Label text="🎬" styleClass="sidebar-logo-icon" />
                <Label text="Scenory" styleClass="sidebar-logo-text" />
            </HBox>

            <!-- Navigation -->
            <VBox spacing="2" styleClass="sidebar-nav">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12" />
                </padding>

                <Button text="Tutorials" styleClass="sidebar-nav-button" onAction="#openTutorials">
                    <graphic><Label text="📚" styleClass="sidebar-nav-icon" /></graphic>
                </Button>
                <Button text="Tips" styleClass="sidebar-nav-button" onAction="#openTips">
                    <graphic><Label text="💡" styleClass="sidebar-nav-icon" /></graphic>
                </Button>
                <Button text="Help" styleClass="sidebar-nav-button" onAction="#showHelp">
                    <graphic><Label text="❓" styleClass="sidebar-nav-icon" /></graphic>
                </Button>
                <Button text="About" styleClass="sidebar-nav-button" onAction="#showAbout">
                    <graphic><Label text="ℹ️" styleClass="sidebar-nav-icon" /></graphic>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Sidebar Footer -->
            <VBox styleClass="sidebar-footer" spacing="2">
                <padding>
                    <Insets top="8" right="12" bottom="16" left="12" />
                </padding>
                <Button text="Settings" styleClass="sidebar-nav-button" onAction="#openSettings">
                    <graphic><Label text="⚙️" styleClass="sidebar-nav-icon" /></graphic>
                </Button>
                <Label text="v1.0" styleClass="sidebar-version">
                    <padding>
                        <Insets top="8" right="0" bottom="0" left="12" />
                    </padding>
                </Label>
            </VBox>
        </VBox>
    </left>

    <!-- ============ MAIN CONTENT (flat background, no image overlay) ============ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="main-scroll-pane">
            <StackPane styleClass="page-background">
                <Region styleClass="page-bg-image" />
                <Region styleClass="page-bg-overlay" />

                <VBox spacing="0" styleClass="main-content">

                <VBox spacing="44" styleClass="content-area">
                    <padding>
                        <Insets top="48" right="56" bottom="80" left="56" />
                    </padding>

                    <!-- ============ HERO — plain text, no boxed panel ============ -->
                    <VBox alignment="CENTER_LEFT" spacing="10" styleClass="hero-section">
                        <Label text="STORYBOARDING" styleClass="hero-eyebrow" />
                        <Label text="Create Beautiful Stories" styleClass="hero-title" wrapText="true" />
                        <Label text="Design storyboards for film, animation, and digital content."
                               styleClass="hero-subtitle" wrapText="true" maxWidth="600" />
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox.margin>
                                <Insets top="12" right="0" bottom="0" left="0" />
                            </VBox.margin>
                            <Button text="Start Creating" styleClass="hero-cta-primary" onAction="#createCustomProject" />
                            <Button text="Open Project" styleClass="hero-cta-secondary" onAction="#openExistingProject" />
                        </HBox>
                    </VBox>

                    <!-- ============ TEMPLATES ============ -->
                    <VBox spacing="16" styleClass="templates-section">
                        <Label text="Quick Start Templates" styleClass="section-title" />

                        <HBox spacing="16" styleClass="template-cards-container">
                            <!-- YouTube Template -->
                            <VBox spacing="0" styleClass="template-card" onMouseClicked="#createYouTubeProject">
                                <StackPane styleClass="template-image-container">
                                    <Label text="📺" styleClass="template-emoji" />
                                </StackPane>
                                <VBox spacing="4">
                                    <padding>
                                        <Insets top="12" right="14" bottom="14" left="14" />
                                    </padding>
                                    <Label text="YouTube Video" styleClass="template-card-title" />
                                    <Label text="16:9 · 30fps" styleClass="template-card-subtitle" />
                                    <Button text="Create" styleClass="template-card-button"
                                            onAction="#createYouTubeProject">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Button>
                                </VBox>
                            </VBox>

                            <!-- Film Template -->
                            <VBox spacing="0" styleClass="template-card" onMouseClicked="#createFilmProject">
                                <StackPane styleClass="template-image-container">
                                    <Label text="🎬" styleClass="template-emoji" />
                                </StackPane>
                                <VBox spacing="4">
                                    <padding>
                                        <Insets top="12" right="14" bottom="14" left="14" />
                                    </padding>
                                    <Label text="Film Production" styleClass="template-card-title" />
                                    <Label text="2.35:1 · 24fps" styleClass="template-card-subtitle" />
                                    <Button text="Create" styleClass="template-card-button"
                                            onAction="#createFilmProject">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Button>
                                </VBox>
                            </VBox>

                            <!-- Custom Template -->
                            <VBox spacing="0" styleClass="template-card" onMouseClicked="#createCustomProject">
                                <StackPane styleClass="template-image-container">
                                    <Label text="⚙️" styleClass="template-emoji" />
                                </StackPane>
                                <VBox spacing="4">
                                    <padding>
                                        <Insets top="12" right="14" bottom="14" left="14" />
                                    </padding>
                                    <Label text="Custom Project" styleClass="template-card-title" />
                                    <Label text="Your specifications" styleClass="template-card-subtitle" />
                                    <Button text="Create" styleClass="template-card-button"
                                            onAction="#createCustomProject">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Button>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ============ RECENT PROJECTS ============ -->
                    <VBox spacing="16" styleClass="recent-section">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="Recent Projects" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="View All" styleClass="view-all-button" onAction="#browseAllProjects" />
                        </HBox>

                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                    styleClass="recent-scroll-pane">
                            <HBox fx:id="recentProjectsContainer" spacing="16" styleClass="recent-projects-grid">
                                <!-- Populated by controller; placeholder below shows on first launch -->
                                <VBox styleClass="empty-state" alignment="CENTER" spacing="6">
                                    <Label text="No recent projects yet" styleClass="empty-state-title" />
                                    <Label text="Start your first storyboard above" styleClass="empty-state-subtitle" />
                                </VBox>
                            </HBox>
                        </ScrollPane>
                    </VBox>

                </VBox>

                </VBox>

            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>
