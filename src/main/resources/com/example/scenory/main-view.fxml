<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.scenory.controller.MainController"
            styleClass="main-border-pane"
            stylesheets="@css/layout/main-interface.css">

    <!-- ============ MENU BAR ============ -->
    <top>
        <VBox styleClass="top-container">
            <MenuBar styleClass="app-menu-bar">
                <Menu text="File">
                    <MenuItem text="New Project" onAction="#newProject" accelerator="Shortcut+N" />
                    <MenuItem text="Save Project" onAction="#saveProject" accelerator="Shortcut+S" />
                    <SeparatorMenuItem />
                    <MenuItem text="Exit" onAction="#exitApplication" />
                </Menu>
                <Menu text="Edit">
                    <MenuItem fx:id="undoMenuItem" text="Undo" onAction="#undo" accelerator="Shortcut+Z" />
                    <MenuItem fx:id="redoMenuItem" text="Redo" onAction="#redo" accelerator="Shortcut+Y" />
                </Menu>
                <Menu text="View">
                    <MenuItem text="Zoom In" accelerator="Shortcut+Plus" />
                    <MenuItem text="Zoom Out" accelerator="Shortcut+Minus" />
                    <MenuItem text="Reset Zoom" accelerator="Shortcut+0" />
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About" onAction="#showAbout" />
                </Menu>
            </MenuBar>

            <!-- Contextual Tool Properties Toolbar -->
            <HBox styleClass="tool-properties-bar" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="4" right="12" bottom="4" left="12" /></padding>
                
                <Label text="Brush Properties" styleClass="section-subhead" />
                <Separator orientation="VERTICAL" />
                
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Size" styleClass="property-label" />
                    <Slider fx:id="brushSizeSlider" min="1" max="100" value="5" styleClass="compact-slider" prefWidth="100" />
                    <Label fx:id="brushSizeValue" text="5px" styleClass="property-value" />
                </HBox>

                <Separator orientation="VERTICAL" />

                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Opacity" styleClass="property-label" />
                    <Slider fx:id="opacitySlider" min="0" max="100" value="100" styleClass="compact-slider" prefWidth="80" />
                    <Label fx:id="opacityValue" text="100%" styleClass="property-value" />
                </HBox>

                <Separator orientation="VERTICAL" />

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Color" styleClass="property-label" />
                    <ColorPicker styleClass="compact-color-picker" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ============ LEFT — Tools Panel ============ -->
    <left>
        <!-- Tools panel will be populated programmatically by MainController -->
        <VBox fx:id="toolsPanelContainer" styleClass="tools-sidebar" />
    </left>

    <!-- ============ CENTER — Infinite Scrollable Workspace ============ -->
    <center>
        <StackPane styleClass="canvas-workspace">
            <ScrollPane fitToWidth="false" fitToHeight="false" styleClass="canvas-scroll-pane" pannable="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                <content>
                    <StackPane styleClass="canvas-container-wrapper" minWidth="920" minHeight="660" maxWidth="920" maxHeight="660">
                        <padding><Insets top="40" right="40" bottom="40" left="40" /></padding>
                        <StackPane styleClass="canvas-frame">
                            <AnchorPane fx:id="canvasContainer" styleClass="drawing-canvas"
                                        minWidth="840" minHeight="580"
                                        prefWidth="840" prefHeight="580"
                                        maxWidth="840" maxHeight="580" />
                        </StackPane>
                    </StackPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

    <!-- ============ RIGHT — Scene Panel ============ -->
    <right>
        <!-- Scene panel will be populated programmatically by MainController -->
        <VBox fx:id="scenePanelContainer" styleClass="scene-sidebar" prefWidth="250" />
    </right>

    <!-- ============ BOTTOM — Timeline & Status Bar ============ -->
    <bottom>
        <VBox>
            <!-- Timeline Panel -->
            <HBox fx:id="timelinePanelContainer" styleClass="timeline-container" prefHeight="80" />
            
            <!-- Status Bar -->
            <HBox fx:id="statusPanelContainer" styleClass="status-bar" />
        </VBox>
    </bottom>

</BorderPane>